  "comcol-role.edit.community-admin.name": "Administratori",

  "comcol-role.edit.collection-admin.name": "Administratori",

  "comcol-role.edit.community-admin.description": "Administratori zajednica mogu stvarati podzajednice ili zbirke, te upravljati ili dodijeliti upravljanje tim podzajednicama ili zbirkama. Osim toga, oni odlučuju tko može podnositi objekte u bilo koju podzbirku, urediti metapodatke objekta (nakon podnošenja) i dodati (mapirati) postojeće objekte iz drugih zbirki (ovisno o autorizaciji).",

  "comcol-role.edit.collection-admin.description": "Administratori zbirki odlučuju tko može podnositi objekte u zbirku, urediti metapodatke objekta (nakon podnošenja) i dodati (mapirati) postojeće objekte iz drugih zbirki u ovu zbirku (ovisno o autorizaciji za tu zbirku).",

  "comcol-role.edit.submitters.name": "Podnositelji",

  "comcol-role.edit.submitters.description": "EOsobe i skupine koje imaju dozvolu podnošenja novih stavki u ovu zbirku.",

  "comcol-role.edit.item_read.name": "Zadani pristup čitanju objekta",

  "comcol-role.edit.item_read.description": "EOsobe i skupine koje mogu čitati nove objekte koji su podneseni u ovu zbirku. Promjene za ovu ulogu nisu retroaktivne. Postojeće objekte u sustavu i dalje će biti vidljive onima koji su imali pristup čitanju u trenutku njihova podnošenja.",

  "comcol-role.edit.item_read.anonymous-group": "Zadano čitanje za dolazne objekte trenutno je postavljeno na Anonimno.",

  "comcol-role.edit.bitstream_read.name": "Zadani pristup čitanju bitovnih nizova",

  "comcol-role.edit.bitstream_read.description": "Administratori zajednice mogu stvarati podzajednice ili zbirke te upravljati ili dodijeliti upravljanje tim podzajednicama ili zbirkama. Osim toga, oni odlučuju tko može podnesti objekte u bilo koju podzbirku, uređivati metapodatke objekta (nakon podnošenja) i dodavati (mapirati) postojeće objekte iz drugih zbirki (ovisno o autorizaciji).",

  "comcol-role.edit.bitstream_read.anonymous-group": "Zadano dopuštenje za čitanje za dolazne bitovne nizove trenutno je postavljeno na Anonimno.",

  "comcol-role.edit.editor.name": "Urednici",

  "comcol-role.edit.editor.description": "Urednici mogu uređivati metapodatke pristiglih podnesaka, a zatim ih prihvatiti ili odbiti.",

  "comcol-role.edit.finaleditor.name": "Konačni urednici",

  "comcol-role.edit.finaleditor.description": "Konačni urednici mogu uređivati metapodatke pristiglih podnesaka, ali ih neće moći odbiti.",

  "comcol-role.edit.reviewer.name": "Recenzenti",

  "comcol-role.edit.reviewer.description": "Recenzenti mogu prihvatiti ili odbiti pristigle podneske. Međutim, oni ne mogu uređivati njihove metapodatke.",

  "comcol-role.edit.scorereviewers.name": "Ocjena recenzenata",

  "comcol-role.edit.scorereviewers.description": "Recenzenti mogu davati ocjene za pristigle podneske, što će odrediti hoće li podnesak biti odbijen ili neće.",

